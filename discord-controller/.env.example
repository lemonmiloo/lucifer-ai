# Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ADMIN_IDS=

# Shared secret between the Discord service and Lua bridge.
# Use a long random value. Never commit the real value.
BRIDGE_TOKEN=

# Must match the allowlist in lua/bridge.lua.
# Only worlds you own or are explicitly authorized to access.
ALLOWED_WORLDS=MYOWNWORLD,MYSECONDOWNWORLD

# Local HTTP server
HOST=127.0.0.1
PORT=8787
BOT_ID=lucifer-main